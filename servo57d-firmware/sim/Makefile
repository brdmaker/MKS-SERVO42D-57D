# Host build of the control core against the virtual drive, for both boards.
CFLAGS ?= -O2 -Wall -Wextra -std=gnu11
SRC = sim_main.c sim_plant.c ../ctrl/servo.c ../ctrl/can_proto.c ../ctrl/mt6816_proto.c ../ctrl/params.c
HDR = sim_plant.h sim_board.h ../ctrl/servo.h ../ctrl/servo_hw.h ../ctrl/servo_hw_57d.h \
      ../ctrl/servo_hw_42d.h ../ctrl/can_proto.h ../ctrl/mt6816_proto.h ../ctrl/params.h

all: sim_test_57d sim_test_42d

sim_test_57d: $(SRC) $(HDR)
	$(CC) $(CFLAGS) -DSV_BOARD_57D -o $@ $(SRC) -lm
sim_test_42d: $(SRC) $(HDR)
	$(CC) $(CFLAGS) -DSV_BOARD_42D -o $@ $(SRC) -lm

check: all check-fw check-image
	./sim_test_57d
	./sim_test_42d

check-57d: sim_test_57d
	./sim_test_57d
check-42d: sim_test_42d
	./sim_test_42d

# trace for plotting: make trace_42d.csv
trace_%.csv: sim_test_%
	./sim_test_$* --demo $@

clean:
	rm -f sim_test sim_test_57d sim_test_42d sim_fw_test trace*.csv *.tmp *.img
.PHONY: all check check-57d check-42d clean

# docs/can_params.md from the parameter table (ranges depend on the board)
docs-params: sim_test_57d sim_test_42d
	{ echo '# CAN parameters'; echo; echo 'Generated by `make -C sim docs-params` from `ctrl/params.c`. Ranges that depend on the sensing range (currents) differ per board. Protocol: `ctrl/can_proto.h`.'; echo; ./sim_test_57d --params-md; ./sim_test_42d --params-md; } > ../docs/can_params.md
.PHONY: docs-params

# CAN firmware update: simulated flash with power loss at every operation
sim_fw_test: sim_fwup.c ../ctrl/fwup.c ../ctrl/fwup.h ../ctrl/params.c ../ctrl/params.h ../ctrl/servo.c ../ctrl/can_proto.c
	$(CC) $(CFLAGS) -DSV_BOARD_57D -o $@ sim_fwup.c ../ctrl/fwup.c ../ctrl/params.c ../ctrl/servo.c ../ctrl/can_proto.c -lm
check-fw: sim_fw_test
	./sim_fw_test
.PHONY: check-fw

# the Python image tool and the C builder must write the same bytes, and the tool must refuse bad input
check-image: sim_fw_test
	python3 -I -c "import struct,random; random.seed(5); b=bytearray(random.randbytes(10001)); struct.pack_into('<II',b,0,0x20008000,0x08002241); open('payload.tmp','wb').write(b)"
	python3 -I ../tools/mkfwimage.py payload.tmp py.img --board 57 --version 3
	./sim_fw_test --make-image payload.tmp c.img 57 3
	cmp py.img c.img && echo "image tool: Python and C builders agree"
	python3 -I ../tools/mkfwimage.py --check py.img --board 57
	! python3 -I ../tools/mkfwimage.py --check py.img --board 42
	python3 -I -c "b=bytearray(open('py.img','rb').read()); b[700]^=1; open('bad.img','wb').write(b)"
	! python3 -I ../tools/mkfwimage.py --check bad.img --board 57
	python3 -I -c "open('junk.tmp','wb').write(bytes(64))"
	! python3 -I ../tools/mkfwimage.py junk.tmp junk.img --board 57
	rm -f payload.tmp py.img c.img bad.img junk.tmp junk.img
.PHONY: check-image
